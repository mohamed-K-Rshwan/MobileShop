<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F3F5F7">

    <TextView
        android:id="@+id/titleSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search Products"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etQuery"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Name contains..."
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/titleSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSearch" />

    <Button
        android:id="@+id/btnSearch"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:text="SEARCH"
        android:textColor="@android:color/white"
        android:backgroundTint="#5BB536"
        app:layout_constraintTop_toTopOf="@id/etQuery"
        app:layout_constraintBottom_toBottomOf="@id/etQuery"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etPriceMin"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Min price"
        android:inputType="numberDecimal"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/etQuery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/etPriceMax" />

    <EditText
        android:id="@+id/etPriceMax"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Max price"
        android:inputType="numberDecimal"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/etQuery"
        app:layout_constraintStart_toEndOf="@id/etPriceMin"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etMinRate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Min rate"
        android:inputType="numberDecimal"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/etPriceMin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnClear" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="90dp"
        android:layout_height="48dp"
        android:text="CLEAR"
        android:textColor="@android:color/white"
        android:backgroundTint="#4AA229"
        app:layout_constraintTop_toTopOf="@id/etMinRate"
        app:layout_constraintBottom_toBottomOf="@id/etMinRate"
        app:layout_constraintEnd_toEndOf="parent" />

    <ListView
        android:id="@+id/listSearchResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/etMinRate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
