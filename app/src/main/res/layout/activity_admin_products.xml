<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F3F5F7">

    <TextView
        android:id="@+id/titleAdminProducts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Products"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnAddProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD"
        android:textColor="@android:color/white"
        android:backgroundTint="#5BB536"
        app:layout_constraintTop_toTopOf="@id/titleAdminProducts"
        app:layout_constraintBottom_toBottomOf="@id/titleAdminProducts"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ListView
        android:id="@+id/listProducts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/titleAdminProducts"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
